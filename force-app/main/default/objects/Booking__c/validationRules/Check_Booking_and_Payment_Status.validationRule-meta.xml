<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Booking_and_Payment_Status</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c, &apos;Confirmed&apos;) &amp;&amp;  ISPICKVAL( Payment_Status__c , &apos;Pending&apos;)</errorConditionFormula>
    <errorMessage>Invalid payment status for current booking status</errorMessage>
</ValidationRule>
