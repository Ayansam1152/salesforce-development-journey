<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Cancellation_After_Start</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c, &apos;Cancelled&apos;) &amp;&amp;  Start_Date_Time__c &lt;  NOW()</errorConditionFormula>
